{
  "root": true,
  "env": {
    "browser": true,
    "node": true,
    "es2023": true,
    "jest": true
  },
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "extends": [
    "eslint:recommended",
    "plugin:prettier/recommended"
  ],
  "plugins": [],
  "rules": {
    "no-console": ["warn", { "allow": ["log", "warn", "error"] }],
    "prefer-const": "error",
    "eqeqeq": ["error", "always"],
    "no-var": "error",
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
    "semi": ["error", "always"],
    "quotes": ["error", "single", { "avoidEscape": true }]
  },
  "overrides": [
    {
      "files": ["**/__tests__/**", "**/*.test.js", "**/*.spec.js"],
      "env": { "jest": true }
    }
  ]
}
