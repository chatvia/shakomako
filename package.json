{
  "name": "shakomako",
  "version": "1.0.0",
  "description": "Shakomako, the embeddable chat widget of Chatvia: a chat bubble and a command bar",
  "main": "dist/embed.js",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run clean && NODE_ENV=production rollup -c rollup.config.ts",
    "build:dev": "npm run clean && rollup -c rollup.config.ts",
    "build:prod": "npm run clean && NODE_ENV=production rollup -c rollup.config.ts",
    "clean": "rimraf dist && mkdir dist",
    "demo": "node serve-demo.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "keywords": [
    "chat",
    "widget",
    "markdown",
    "sse"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-strip": "^3.0.4",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^22.20.5",
    "@types/postcss-import": "^14.0.3",
    "dotenv": "^17.4.2",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "fs-extra": "^11.3.5",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.15",
    "postcss-import": "^16.1.1",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "rollup": "^4.61.1",
    "rollup-plugin-dotenv": "^0.5.1",
    "rollup-plugin-gzip": "^4.2.0",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-visualizer": "^7.0.1",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.0.16",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-subresource-integrity": "^0.0.12",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "dompurify": "^3.4.8",
    "pusher-js": "^8.5.0"
  },
  "overrides": {
    "rollup-plugin-postcss": {
      "cssnano": "^7.1.9"
    }
  }
}
