# Branding
VITE_BRANDING_ENABLED=true
VITE_BRAND_NAME="Chat Widget"
VITE_BRAND_URL="https://example.com"

# WebSocket
VITE_WEBSOCKET_URL="ws://localhost:8000/ws"
VITE_WEBSOCKET_RECONNECT_DELAY=3000
VITE_WEBSOCKET_MAX_RECONNECT_ATTEMPTS=5

# Feedback
VITE_FEEDBACK_ENABLED=true
VITE_FEEDBACK_GOOD_URL="http://localhost:8000/feedback/good"
VITE_FEEDBACK_BAD_URL="http://localhost:8000/feedback/bad"

# Visitor ID
VITE_VISITOR_ID_ENABLED=true
VITE_VISITOR_ID_COOKIE_NAME="chatWidgetVisitorId"
VITE_VISITOR_ID_COOKIE_EXPIRATION=365
VITE_VISITOR_API_URL="http://localhost:8000/api"

# Other options
VITE_MARKDOWN_ENABLED=true

