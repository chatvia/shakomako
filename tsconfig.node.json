{
  // Build and dev tooling that runs in Node: the tool configs and the demo server.
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "noEmit": true,

    "target": "ES2023",
    "lib": ["ES2023"],
    "types": ["node"],

    "module": "ESNext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    // Node runs rollup.config.ts and serve-demo.ts by stripping their types,
    // which only works for syntax that can be erased (no enums, namespaces…).
    "erasableSyntaxOnly": true,

    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["*.config.ts", "serve-demo.ts"]
}
